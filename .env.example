# --------------------------------------------------------------------------
# Event Booking Platform - example environment configuration
# --------------------------------------------------------------------------
# Copy this file to .env for local development:
#     cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# --------------------------------------------------------------------------

# HTTP server
PORT=8080
HTTP_READ_TIMEOUT_SEC=10
HTTP_WRITE_TIMEOUT_SEC=15

# PostgreSQL (libpq URL consumed by pgx). Host port 5433 matches docker-compose.yml
# (5433 avoids colliding with a host-native PostgreSQL on 5432).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/event_booking?sslmode=disable

# Redis (consumed by go-redis; backs the Asynq task queue in Phase 2)
REDIS_URL=redis://localhost:6379/0

# Authentication (Phase 2) - use a long random string in any environment
JWT_SECRET=replace-with-a-long-random-string

# Resend transactional email (Phase 2)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Event Booking <no-reply@example.com>
